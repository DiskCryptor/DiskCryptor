[Defines]
  INF_VERSION                    = 0x00010006
  BASE_NAME                      = DiskCryptorLib
  MODULE_UNI_FILE                = DiskCryptorLib.uni
  FILE_GUID                      = 6166A5F2-3257-4856-9E85-5409564975B4
  MODULE_TYPE                    = UEFI_DRIVER
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = DiskCryptorLib|DXE_DRIVER DXE_RUNTIME_DRIVER UEFI_APPLICATION UEFI_DRIVER

#
#  VALID_ARCHITECTURES           = X64 AARCH64
#

[Sources]
  DcsConfigMenu.h
  DcsDiskCryptor.h
  emmintrin.h
  crypto_lib/cl_platform.h
  crypto_lib/cl_alloc.h
  crypto_lib/cl_cpu.h
  crypto_lib/aes_asm.h
  crypto_lib/aes_key.h
  crypto_lib/serpent.h
  crypto_lib/twofish.h
  crypto_lib/sha512.h
  crypto_lib/sha512_hmac.h
  crypto_lib/sha512_pkcs5_2.h
  crypto_lib/crc32.h
  crypto_lib/xts_fast.h
  crypto_lib/xts_aes_ni.h
  crypto_lib/xts_serpent_sse2.h
  crypto_lib/xts_twofish.h
  crypto_lib/xts_aes_ce.h
  crypto_lib/xts_serpent_neon.h
  crypto_lib/Argon2/argon2.h
  crypto_lib/Argon2/argon2_mt.h
  crypto_lib/Argon2/core.h
  crypto_lib/Argon2/blake2/blake2b.h
  crypto_lib/Argon2/blake2/blake2-impl.h
  crypto_lib/Argon2/blake2/blamka-round-ref.h
  crypto_lib/Argon2/blake2/blamka-round-opt.h
  crypto_lib/Argon2/blake2/blamka-round-neon.h
  include/volume_header.h
  include/bootloader.h
  include/dc_header.h
  volume_lib/dc_dev.h
  volume_lib/dc_internal.h
  volume_lib/dc_status.h
  volume_lib/crypto_head.h
  volume_lib/header_io.h
  volume_lib/keyfile_mix.h
  include/dc_keyfiles.h
  include/dc_io.h
  include/defines.h
  intrin.h

[Sources.common]
  DcsCliHelpers.c
  DcsConfigMenu.c
  DcsTpmSupport.c
  DcsVarMgmt.c
  DcsDiskCryptor.c
  # volume_lib, shared with the driver and dcapi. Reached through a junction
  # created by ci_build_dcs.cmd, because EDK2 keeps [Sources] inside the module.
  volume_lib/dc_host.c
  volume_lib/crypto_head.c
  volume_lib/header_io.c
  volume_lib/keyfile_mix.c
  dc_host_efi.c
  dc_io.c
  crypto_lib/crc32.c
  crypto_lib/Argon2/argon2.c
  crypto_lib/Argon2/argon2_mt.c
  crypto_lib/Argon2/core.c
  crypto_lib/Argon2/ref.c
  crypto_lib/Argon2/blake2/blake2b.c

[Sources.X64]
  crypto_lib/sha512.c
  crypto_lib/sha512_pkcs5_2.c
  crypto_lib/sha512_hmac.c
  crypto_lib/xts_fast.c
  crypto_lib/aes_key.c
  crypto_lib/twofish.c
  crypto_lib/serpent.c
  # XTS-AES-NI, XTS-Serpent-SSE2 and XTS-Twofish are C now; only the
  # Gladman AES core is still assembler. The AVX and AVX2 Serpent tiers
  # are left out: they need per-file /arch: switches EDK2 has no way to
  # give, so CL_ENABLE_AVX/AVX2 stay undefined and Serpent runs on the
  # SSE2 core - the same choice the driver makes. cl_cpu.c exists only
  # to probe for those tiers, so it is left out with them.
  crypto_lib/xts_aes_ni.c
  crypto_lib/xts_serpent_sse2.c
  crypto_lib/xts_twofish.c
  crypto_lib/amd64/aes_amd64.nasm
  # Argon2's SIMD core. ref.c dispatches to fill_segment_sse2 on x64, so the
  # file that defines it has to be here and not in the common list - an
  # architecture that forgets its core gets a link error, not a silent
  # fallback to the scalar one. opt_avx2.c is built but never selected:
  # CL_ENABLE_AVX2 stays undefined for the same reason the AVX Serpent tiers
  # are left out above.
  crypto_lib/Argon2/opt_sse2.c
  crypto_lib/Argon2/opt_avx2.c

[Sources.AARCH64]
  crypto_lib/sha512.c
  crypto_lib/sha512_pkcs5_2.c
  crypto_lib/sha512_hmac.c
  crypto_lib/xts_fast.c
  crypto_lib/aes_key.c
  crypto_lib/twofish.c
  crypto_lib/serpent.c
  crypto_lib/xts_aes_ce.c
  crypto_lib/xts_serpent_neon.c
  crypto_lib/xts_twofish.c
  # the AARCH64 half of the pair above: ref.c dispatches to fill_segment_neon
  # here. NEON needs no /arch: switch and no runtime probe, so unlike the AVX
  # tiers this one is actually used.
  crypto_lib/Argon2/opt_neon.c

[Packages]
  MdePkg/MdePkg.dec
  DcsPkg/DcsPkg.dec
  CryptoPkg/CryptoPkg.dec

[LibraryClasses]
  MemoryAllocationLib
  UefiLib
  UefiBootServicesTableLib
  RngLib
  BaseCryptLib
  DebugLib
  SynchronizationLib
  ConsoleLib
  MiscUtilsLib
  SupportLib

[Guids]
  gEfiPartTypeUnusedGuid
  gEfiPartTypeSystemPartGuid
  gEfiFileSystemInfoGuid
  gEfiDcsOwnerGuid
  gEfiGlobalVariableGuid

[Protocols]
  gEfiMpServiceProtocolGuid     ## CONSUMES


# /wd4201: volume_header.h overlays stor_off with data_off, and the
# deprecated use_size field with stor_len/head_len, in anonymous unions.
# That is the on-disk format; the driver owns the header and the rest of
# the tree compiles it the same way.
[BuildOptions.X64]
MSFT:DEBUG_*_X64_CC_FLAGS    == /nologo /c /WX /GS- /W4 /Gs32768 /D UNICODE /Gy /FIAutoGen.h /EHs-c- /GR- /GF /Zi /Gm /D_UEFI /wd4201
MSFT:RELEASE_*_X64_CC_FLAGS  == /nologo /c /WX /GS- /W4 /Gs32768 /D UNICODE /Gy /FIAutoGen.h /EHs-c- /GR- /GF /D_UEFI /O2 /wd4201
MSFT:NOOPT_*_X64_CC_FLAGS    == /nologo /c /WX /GS- /W4 /Gs32768 /D UNICODE /Gy /FIAutoGen.h /EHs-c- /GR- /GF /Zi /Gm /Od /D_UEFI /wd4201

[BuildOptions.AARCH64]
MSFT:DEBUG_*_AARCH64_CC_FLAGS    == /nologo /c /WX /GS- /W4 /Gs32768 /D UNICODE /Gy /FIAutoGen.h /EHs-c- /GR- /GF /Zi /Gm /D_UEFI /wd4201
MSFT:RELEASE_*_AARCH64_CC_FLAGS  == /nologo /c /WX /GS- /W4 /Gs32768 /D UNICODE /Gy /FIAutoGen.h /EHs-c- /GR- /GF /D_UEFI /O2 /wd4201
MSFT:NOOPT_*_AARCH64_CC_FLAGS    == /nologo /c /WX /GS- /W4 /Gs32768 /D UNICODE /Gy /FIAutoGen.h /EHs-c- /GR- /GF /Zi /Gm /Od /D_UEFI /wd4201
